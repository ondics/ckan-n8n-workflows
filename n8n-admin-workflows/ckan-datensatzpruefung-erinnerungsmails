      "name": "Formular: Datensatzprüfung starten",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.5,
      "position": [
        -256,
        640
      ]
    },
    {
      "parameters": {
        "jsCode": "const form = $input.first().json;\nconst startart = form.startart || \"formular\";\n\nconst pruefungAuswahl =\n  form.pruefung_auswahl ||\n  form[\"Was soll geprüft werden?\"];\n\nconst empfaengerAuswahl =\n  form.empfaenger_auswahl ||\n  form[\"Wer soll erinnert werden?\"];\n\nconst ausfuehrung =\n  form.ausfuehrung ||\n  form[\"Ausführung\"];\n\nconst notiz =\n  form.notiz ||\n  form[\"Zusätzlicher Hinweis für die E-Mail\"] ||\n  \"\";\n\nlet pruefung;\nlet pruefungText;\nlet thresholdDate = new Date();\nconst today = new Date();\n\nif (pruefungAuswahl === \"4 Wochen\") {\n  pruefung = \"4_wochen\";\n  pruefungText = \"4 Wochen nicht aktualisiert\";\n  thresholdDate.setDate(today.getDate() - 28);\n} else if (pruefungAuswahl === \"6 Monate\") {\n  pruefung = \"6_monate\";\n  pruefungText = \"länger als 6 Monate nicht aktualisiert\";\n  thresholdDate.setMonth(today.getMonth() - 6);\n} else if (pruefungAuswahl === \"1 Jahr\") {\n  pruefung = \"1_jahr\";\n  pruefungText = \"länger als 1 Jahr nicht aktualisiert\";\n  thresholdDate.setFullYear(today.getFullYear() - 1);\n} else {\n  throw new Error(\"Unbekannte Prüfauswahl: \" + pruefungAuswahl);\n}\n\nlet empfaenger;\nif (empfaengerAuswahl === \"Nur Sysadmin erhält eine Gesamtliste\") {\n  empfaenger = \"sysadmin\";\n} else if (empfaengerAuswahl === \"Nur Datensatzkontakte erhalten ihre eigenen Datensätze\") {\n  empfaenger = \"autoren\";\n} else if (empfaengerAuswahl === \"Sysadmin und Datensatzkontakte\") {\n  empfaenger = \"beide\";\n} else {\n  throw new Error(\"Unbekannte Empfänger-Auswahl: \" + empfaengerAuswahl);\n}\nlet modus;\nif (ausfuehrung === \"E-Mails wirklich senden\") {\n  modus = \"senden\";\n} else if (ausfuehrung === \"Testversand an TEST_EMAIL\") {\n  modus = \"test\";\n} else {\n  modus = \"vorschau\";\n}\n\n\n\nconst sysadminEmail = $env.SYSADMIN_EMAIL || \"\";\nconst testEmail = $env.TEST_EMAIL || \"\";\nconst emailFrom = $env.EMAIL_FROM || \"\";\n\n\nif (!sysadminEmail && (empfaenger === \"sysadmin\" || empfaenger === \"beide\")) {\n  throw new Error(\"SYSADMIN_EMAIL ist nicht gesetzt, obwohl Sysadmin-Versand ausgewählt wurde.\");\n}\n\nif (modus === \"test\" && !testEmail) {\n  throw new Error(\"TEST_EMAIL ist nicht gesetzt, obwohl Testversand ausgewählt wurde.\");\n}\n\nif ((modus === \"test\" || modus === \"senden\") && !emailFrom) {\n  throw new Error(\"EMAIL_FROM ist nicht gesetzt. Diese Variable wird als Absenderadresse verwendet.\");\n}\n\nreturn [\n  {\n    json: {\n      pruefung,\n      pruefungText,\n      empfaenger,\n      modus,\n      notiz,\n      todayIso: today.toISOString(),\n      thresholdDateIso: thresholdDate.toISOString(),\n      thresholdTimestamp: thresholdDate.getTime(),\n      sysadminEmail,\n      testEmail,\n      emailFrom,\n      maxRows: 1000,\n      includePrivate: true,\n      startart,\n    }\n  }\n];"
      },
      "name": "Formularwerte und Prüfparameter vorbereiten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        192,
        544
      ]
    },
    {
      "parameters": {
        "jsCode": "const ckanResponse = $input.first().json;\n\n// Die CKAN-Antwort kann je nach Node unterschiedlich aufgebaut sein.\n// HTTP Request Node: response.result.results\n// Custom CKAN Node: response.data.results\n\nconst response = ckanResponse.body || ckanResponse;\n\nif (!response) {\n  throw new Error(\"Keine Antwort von CKAN erhalten.\");\n}\n\nif (response.success === false || response.data?.success === false) {\n  const errorMessage =\n    response.error?.message ||\n    response.data?.error?.message ||\n    JSON.stringify(response.error || response.data?.error || response);\n\n  throw new Error(\"CKAN-API-Fehler: \" + errorMessage);\n}\n\nconst result =\n  response.result ||\n  response.data ||\n  response.body?.result ||\n  response.body?.data ||\n  {};\n\nconst packages = result.results || [];\n\nreturn [\n  {\n    json: {\n      ckanCount: result.count ?? packages.length,\n      returnedCount: packages.length,\n      packages\n    }\n  }\n];"
      },
      "name": "CKAN-Antwort prüfen und extrahieren",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        544
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst params = $(\"Formularwerte und Prüfparameter vorbereiten\").first().json;\nconst startart = params.startart || \"formular\";\n\nconst packages = data.packages || [];\nconst thresholdTimestamp = params.thresholdTimestamp;\n\nconst ckanSiteUrl = String($env.CKAN_SITE_URL || \"\").replace(/\\/$/, \"\");\nconst sysadminEmail = params.sysadminEmail;\nconst testEmail = params.testEmail;\nconst empfaenger = params.empfaenger;\nconst modus = params.modus;\nconst pruefungText = params.pruefungText;\nconst notiz = params.notiz || \"\";\n\nfunction escapeHtml(value) {\n  return String(value ?? \"\")\n    .replaceAll(\"&\", \"&amp;\")\n    .replaceAll(\"<\", \"&lt;\")\n    .replaceAll(\">\", \"&gt;\")\n    .replaceAll('\"', \"&quot;\")\n    .replaceAll(\"'\", \"&#039;\");\n}\n\nfunction cleanEmail(value) {\n  if (!value) return null;\n  const email = String(value).trim();\n  if (!email) return null;\n  if (!email.includes(\"@\")) return null;\n  return email;\n}\n\nfunction formatDateGerman(dateValue) {\n  if (!dateValue) return \"unbekannt\";\n  const date = new Date(dateValue);\n  if (Number.isNaN(date.getTime())) return \"unbekannt\";\n  return date.toLocaleDateString(\"de-DE\");\n}\n\nfunction daysSince(dateValue) {\n  const date = new Date(dateValue);\n  if (Number.isNaN(date.getTime())) return null;\n  const diffMs = Date.now() - date.getTime();\n  return Math.floor(diffMs / (1000 * 60 * 60 * 24));\n}\n\nfunction datasetUrl(pkg) {\n  if (!pkg.name) return ckanSiteUrl;\n  return `${ckanSiteUrl}/dataset/${encodeURIComponent(pkg.name)}`;\n}\n\nfunction getOwnerOrg(pkg) {\n  return (\n    pkg.owner_org ||\n    pkg.organization?.id ||\n    pkg.organization?.name ||\n    null\n  );\n}\n\nfunction contactLabel(contact) {\n  if (!contact) return \"keine Kontaktadresse\";\n\n  const parts = [];\n\n  if (contact.email) parts.push(contact.email);\n  if (contact.source) parts.push(contact.source);\n  if (contact.name) parts.push(contact.name);\n\n  return parts.join(\" · \") || \"keine Kontaktadresse\";\n}\n\nfunction wrapEmail(title, innerHtml) {\n  return `\n    <div style=\"\n      background: #f2f2f2;\n      color: #222;\n      font-family: Georgia, 'Times New Roman', serif;\n      padding: 28px 18px;\n    \">\n      <div style=\"\n        max-width: 820px;\n        margin: 0 auto;\n        background: #f6f6f6;\n        border: 1px solid #b7b7b7;\n        border-radius: 10px;\n        padding: 28px 34px;\n      \">\n        <h1 style=\"\n          color: #990000;\n          font-weight: 400;\n          font-size: 30px;\n          line-height: 1.2;\n          margin: 0 0 18px 0;\n          padding-bottom: 12px;\n          border-bottom: 1px solid #c8c8c8;\n        \">\n          ${escapeHtml(title)}\n        </h1>\n\n        ${innerHtml}\n      </div>\n    </div>\n  `;\n}\n\nfunction emailBox(innerHtml) {\n  return `\n    <div style=\"\n      background: #fdfdfd;\n      border: 1px solid #c8c8c8;\n      border-radius: 8px;\n      padding: 18px 20px;\n      margin: 0 0 18px 0;\n    \">\n      ${innerHtml}\n    </div>\n  `;\n}\n\nfunction buildContactRows(contacts) {\n  if (!contacts || !contacts.length) {\n    return `<p style=\"margin: 6px 0;\">Keine Datensatzkontakte vorhanden.</p>`;\n  }\n\n  return contacts.map(contact => `\n    <p style=\"margin: 6px 0; line-height: 1.5;\">\n      <strong>${escapeHtml(contact.email)}</strong><br>\n      <span style=\"font-size: 14px; color: #555;\">\n        ${escapeHtml(contact.source)}\n        ${contact.name ? ` · ${escapeHtml(contact.name)}` : \"\"}\n      </span>\n    </p>\n  `).join(\"\");\n}\n\nfunction buildDatasetRows(datasets, includeContact = false) {\n  if (!datasets.length) {\n    return `<p style=\"margin: 8px 0;\">Keine Datensätze vorhanden.</p>`;\n  }\n\n  return datasets.map((d) => {\n    const contactBlock = includeContact\n      ? `\n        <p style=\"margin: 10px 0 4px 0;\">\n          <strong>Datensatzkontakte:</strong>\n        </p>\n        ${buildContactRows(d.contacts || [])}\n      `\n      : \"\";\n\n    return `\n      <div style=\"\n        border-top: 1px solid #d6d6d6;\n        padding: 18px 0 14px 0;\n      \">\n        <h3 style=\"\n          color: #990000;\n          font-weight: 400;\n          font-size: 21px;\n          line-height: 1.25;\n          margin: 0 0 8px 0;\n        \">\n          <a href=\"${escapeHtml(d.url)}\" target=\"_blank\" style=\"\n            color: #990000;\n            text-decoration: underline;\n            font-weight: 400;\n          \">\n            ${escapeHtml(d.title)}\n          </a>\n        </h3>\n\n        <p style=\"margin: 6px 0; line-height: 1.5;\">\n          <strong>Name:</strong> ${escapeHtml(d.name)}<br>\n          <strong>Organisation:</strong> ${escapeHtml(d.organizationTitle || \"unbekannt\")}<br>\n          <strong>Letzte Änderung:</strong> ${escapeHtml(d.lastModifiedReadable)}<br>\n          <strong>Tage seit Änderung:</strong> ${escapeHtml(d.daysSinceLastUpdate ?? \"unbekannt\")}\n        </p>\n\n        ${contactBlock}\n      </div>\n    `;\n  }).join(\"\");\n}\n\nconst normalizedDatasets = [];\nconst skippedWithoutModified = [];\nconst overdueDatasets = [];\nconst datasetsWithoutContact = [];\nconst authorGroups = {};\n\nfor (const pkg of packages) {\n  const lastModified = pkg.metadata_modified || null;\n\n  if (!lastModified) {\n    skippedWithoutModified.push({\n      id: pkg.id || \"\",\n      name: pkg.name || \"\",\n      title: pkg.title || pkg.name || \"Ohne Titel\"\n    });\n    continue;\n  }\n\n  const lastModifiedDate = new Date(lastModified);\n\n  if (Number.isNaN(lastModifiedDate.getTime())) {\n    skippedWithoutModified.push({\n      id: pkg.id || \"\",\n      name: pkg.name || \"\",\n      title: pkg.title || pkg.name || \"Ohne Titel\"\n    });\n    continue;\n  }\n\n  const authorEmail = cleanEmail(pkg.author_email);\n  const maintainerEmail = cleanEmail(pkg.maintainer_email);\n\n  const contacts = [];\n\n  if (authorEmail) {\n    contacts.push({\n      email: authorEmail,\n      source: \"author_email\",\n      name: pkg.author || \"\"\n    });\n  }\n\n  if (maintainerEmail && maintainerEmail !== authorEmail) {\n    contacts.push({\n      email: maintainerEmail,\n      source: \"maintainer_email\",\n      name: pkg.maintainer || \"\"\n    });\n  }\n\n  const contactEmail = contacts[0]?.email || null;\n\n  const normalized = {\n    id: pkg.id || \"\",\n    name: pkg.name || \"\",\n    title: pkg.title || pkg.name || \"Ohne Titel\",\n    ownerOrg: getOwnerOrg(pkg),\n    organizationTitle: pkg.organization?.title || pkg.organization?.name || \"\",\n    author: pkg.author || \"\",\n    authorEmail,\n    maintainer: pkg.maintainer || \"\",\n    maintainerEmail,\n    contactEmail,\n    contactSource: contacts[0]?.source || null,\n    contacts,\n    lastModified,\n    lastModifiedReadable: formatDateGerman(lastModified),\n    daysSinceLastUpdate: daysSince(lastModified),\n    url: datasetUrl(pkg)\n  };\n\n  normalizedDatasets.push(normalized);\n\n  if (lastModifiedDate.getTime() < thresholdTimestamp) {\n    overdueDatasets.push(normalized);\n\n    if (contacts.length) {\n      for (const contact of contacts) {\n        const email = contact.email;\n\n        if (!authorGroups[email]) {\n          authorGroups[email] = [];\n        }\n\n        if (!authorGroups[email].some(dataset => dataset.id === normalized.id)) {\n          authorGroups[email].push(normalized);\n        }\n      }\n    } else {\n      datasetsWithoutContact.push(normalized);\n    }\n  }\n}\n\nconst mailJobs = [];\n\n// Sysadmin-Mail erstellen\nif (empfaenger === \"sysadmin\" || empfaenger === \"beide\") {\n  const adminHtml = wrapEmail(\n    \"Prüfliste: überfällige CKAN-Datensätze\",\n    `\n      ${emailBox(`\n        <p style=\"font-size: 18px; line-height: 1.5; margin: 0 0 12px 0;\">\n          Es wurden Datensätze gesucht, die <strong>${escapeHtml(pruefungText)}</strong> sind.\n        </p>\n\n        <h2 style=\"\n          color: #990000;\n          font-weight: 400;\n          font-size: 23px;\n          margin: 18px 0 10px 0;\n          border-bottom: 1px solid #d6d6d6;\n          padding-bottom: 4px;\n        \">\n          Zusammenfassung\n        </h2>\n\n        <ul style=\"margin: 10px 0 0 22px; padding: 0; line-height: 1.55;\">\n          <li><strong>Geprüfte Datensätze:</strong> ${normalizedDatasets.length}</li>\n          <li><strong>Von CKAN zurückgegeben:</strong> ${packages.length}</li>\n          <li><strong>Überfällige Datensätze:</strong> ${overdueDatasets.length}</li>\n          <li><strong>Datensätze ohne Datensatzkontakt:</strong> ${datasetsWithoutContact.length}</li>\n          <li><strong>Datensätze ohne gültiges Änderungsdatum:</strong> ${skippedWithoutModified.length}</li>\n        </ul>\n\n        ${notiz ? `\n          <p style=\"margin: 16px 0 0 0;\">\n            <strong>Hinweis:</strong> ${escapeHtml(notiz)}\n          </p>\n        ` : \"\"}\n      `)}\n\n      ${emailBox(`\n        <h2 style=\"\n          color: #990000;\n          font-weight: 400;\n          font-size: 23px;\n          margin: 0 0 10px 0;\n          border-bottom: 1px solid #d6d6d6;\n          padding-bottom: 4px;\n        \">\n          Überfällige Datensätze\n        </h2>\n\n        ${buildDatasetRows(overdueDatasets, true)}\n      `)}\n\n      ${emailBox(`\n        <h2 style=\"\n          color: #990000;\n          font-weight: 400;\n          font-size: 23px;\n          margin: 0 0 10px 0;\n          border-bottom: 1px solid #d6d6d6;\n          padding-bottom: 4px;\n        \">\n          Datensätze ohne Datensatzkontakt\n        </h2>\n\n        <p style=\"line-height: 1.5; margin: 0 0 12px 0;\">\n          Diese Datensätze haben weder <code>author_email</code> noch <code>maintainer_email</code>.\n        </p>\n\n        ${buildDatasetRows(datasetsWithoutContact, true)}\n      `)}\n    `\n  );\n\n  mailJobs.push({\n    type: \"admin\",\n    to: sysadminEmail,\n    originalTo: sysadminEmail,\n    subject: `Prüfliste: ${overdueDatasets.length} überfällige CKAN-Datensätze`,\n    html: adminHtml\n  });\n}\n\n// Datensatzkontakt-Mails erstellen: author_email + maintainer_email\nif (empfaenger === \"autoren\" || empfaenger === \"beide\") {\n  for (const [email, datasets] of Object.entries(authorGroups)) {\n    const authorHtml = wrapEmail(\n      \"Bitte CKAN-Datensätze prüfen\",\n      `\n        ${emailBox(`\n          <p style=\"font-size: 18px; line-height: 1.5; margin: 0 0 12px 0;\">\n            Hallo,\n          </p>\n\n          <p style=\"line-height: 1.5; margin: 0 0 12px 0;\">\n            folgende CKAN-Datensätze wurden seit längerer Zeit nicht aktualisiert.\n          </p>\n\n          <p style=\"line-height: 1.5; margin: 0;\">\n            <strong>Ausgewählte Prüfung:</strong> ${escapeHtml(pruefungText)}\n          </p>\n\n          ${notiz ? `\n            <p style=\"margin: 16px 0 0 0;\">\n              <strong>Hinweis:</strong> ${escapeHtml(notiz)}\n            </p>\n          ` : \"\"}\n        `)}\n\n        ${emailBox(`\n          <h2 style=\"\n            color: #990000;\n            font-weight: 400;\n            font-size: 23px;\n            margin: 0 0 10px 0;\n            border-bottom: 1px solid #d6d6d6;\n            padding-bottom: 4px;\n          \">\n            Zu prüfende Datensätze\n          </h2>\n\n          ${buildDatasetRows(datasets, false)}\n        `)}\n\n        ${emailBox(`\n          <p style=\"line-height: 1.5; margin: 0 0 12px 0;\">\n            Bitte prüfen Sie, ob die Inhalte noch aktuell sind oder ob eine Aktualisierung notwendig ist.\n          </p>\n\n          <p style=\"line-height: 1.5; margin: 0;\">\n            Vielen Dank.\n          </p>\n        `)}\n      `\n    );\n\n    mailJobs.push({\n      type: \"author\",\n      to: email,\n      originalTo: email,\n      subject: `Bitte CKAN-Datensätze prüfen: ${datasets.length} Datensatz/Datensätze`,\n      html: au