          "appendAttribution": false,
          "buttonLabel": "Prüfung starten",
          "customCss": ":root {\n  --font-family: Georgia, \"Times New Roman\", serif;\n  --font-weight-normal: 400;\n  --font-weight-bold: 700;\n\n  --font-size-body: 18px;\n  --font-size-label: 16px;\n  --font-size-header: 22px;\n  --font-size-paragraph: 18px;\n\n  --font-size-html-h1: 34px;\n  --font-size-html-h2: 28px;\n  --font-size-html-h3: 22px;\n  --font-size-html-h4: 18px;\n\n  --color-primary: #990000;\n  --color-primary-shade-1: #7f0000;\n  --color-primary-shade-2: #660000;\n}\n\nhtml,\nbody {\n  width: 100% !important;\n  margin: 0 !important;\n  padding: 0 !important;\n}\n\nbody {\n  background: #f2f2f2 !important;\n  color: #222 !important;\n  display: flex !important;\n  justify-content: center !important;\n  align-items: flex-start !important;\n}\n\nmain,\nsection,\n.form-container {\n  background: #f2f2f2 !important;\n  max-width: none !important;\n  width: 100% !important;\n  margin: 0 auto !important;\n  display: flex !important;\n  justify-content: center !important;\n}\n\nform {\n  background: #f6f6f6 !important;\n  border: 1px solid #b7b7b7 !important;\n  border-radius: 10px !important;\n  box-shadow: none !important;\n  width: min(980px, calc(100vw - 48px)) !important;\n  max-width: 980px !important;\n  margin: 32px auto !important;\n  padding: 30px 36px !important;\n  text-align: left !important;\n}\n\nh1 {\n  color: #990000 !important;\n  font-weight: 400 !important;\n  text-align: left !important;\n  margin-bottom: 22px !important;\n  border-bottom: 1px solid #c8c8c8;\n  padding-bottom: 12px;\n}\n\nh2 {\n  color: #990000 !important;\n  font-weight: 400 !important;\n  text-align: left !important;\n  margin: 0 0 18px 0 !important;\n}\n\nh3 {\n  color: #990000 !important;\n  font-weight: 400 !important;\n  text-align: left !important;\n  margin: 18px 0 10px 0 !important;\n  border-bottom: 1px solid #d6d6d6;\n  padding-bottom: 4px;\n}\n\np,\nli,\ndiv,\nspan {\n  color: #222 !important;\n  text-align: left !important;\n  line-height: 1.5 !important;\n}\n\nul {\n  margin: 10px 0 18px 22px !important;\n  padding: 0 !important;\n}\n\nli {\n  margin: 6px 0 !important;\n}\n\na {\n  color: #990000 !important;\n  text-decoration: underline !important;\n  font-weight: 400 !important;\n}\n\ncode {\n  background: #ececec !important;\n  border: 1px solid #d2d2d2 !important;\n  border-radius: 4px !important;\n  padding: 1px 5px !important;\n  font-size: 0.95em !important;\n}\n\nbutton {\n  background: linear-gradient(#bb0000, #8f0000) !important;\n  color: #fff !important;\n  border: 1px solid #6f0000 !important;\n  border-radius: 6px !important;\n  font-weight: 700 !important;\n  box-shadow: none !important;\n}\n\nbutton:hover {\n  background: linear-gradient(#a40000, #7f0000) !important;\n}\n\ninput,\nselect,\ntextarea {\n  background: #fff !important;\n  border: 1px solid #c8c8c8 !important;\n  border-radius: 6px !important;\n  color: #222 !important;\n}\n\n.report-page {\n  text-align: left !important;\n}\n\n.report-box {\n  background: #fdfdfd;\n  border: 1px solid #c8c8c8;\n  border-radius: 8px;\n  padding: 18px 20px;\n  margin: 0 0 18px 0;\n}\n\n.note-box {\n  background: #f3f3f3;\n}\n\n.lead {\n  font-size: 1.08em;\n  margin-bottom: 14px;\n}"
